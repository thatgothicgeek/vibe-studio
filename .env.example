# Server-only settings. Set values in Hostinger; never use a VITE_ prefix.
STUDIO_HUB_READ_TOKEN=

# Separate Hub action token for approved Studio writes such as manual refresh.
STUDIO_HUB_ACTION_TOKEN=

# Argon2id password hash. Never store the plaintext password here or in Git.
STUDIO_PASSWORD_HASH=

# Random session-signing secret, minimum 32 bytes.
STUDIO_SESSION_SECRET=

PORT=3000
